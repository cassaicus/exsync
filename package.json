{
  "name": "antigravity-settings-sync",
  "displayName": "Antigravity Sync",
  "description": "Sync your Antigravity settings and extensions using GitHub",
  "version": "1.0.0",
  "publisher": "local",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "antigravity-sync.upload",
        "title": "Antigravity Sync: Upload Settings",
        "category": "Antigravity Sync"
      },
      {
        "command": "antigravity-sync.download",
        "title": "Antigravity Sync: Download Settings",
        "category": "Antigravity Sync"
      },
      {
        "command": "antigravity-sync.sync",
        "title": "Antigravity Sync: Sync Now",
        "category": "Antigravity Sync"
      }
    ],
    "configuration": {
      "title": "Antigravity Sync",
      "properties": {
        "antigravitySync.autoSync": {
          "type": "boolean",
          "default": true,
          "description": "Automatically sync settings on changes"
        },
        "antigravitySync.repoName": {
          "type": "string",
          "default": "antigravity-sync-data",
          "description": "The name of the private GitHub repository to store data"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/node": "^16.18.34",
    "typescript": "^5.1.3",
    "@typescript-eslint/eslint-plugin": "^5.59.8",
    "@typescript-eslint/parser": "^5.59.8",
    "eslint": "^8.41.0"
  }
}
